.page {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 40, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #1f2328;
}

.kv {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.k {
  width: 160rpx;
  color: #6e7781;
  flex-shrink: 0;
}

.v {
  flex: 1;
  word-break: break-all;
  color: #1f2328;
}

.tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8c959f;
  line-height: 1.5;
}

/* ── 自检项 ─────────────────────────────────────────── */
.check {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-top: 1rpx solid #eaeef2;
}

.check:first-of-type {
  border-top: none;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin: 10rpx 18rpx 0 0;
  flex-shrink: 0;
  background: #d0d7de;
}

.dot-loading {
  background: #d4a72c;
}

.dot-ok {
  background: #1a7f37;
}

.dot-fail {
  background: #cf222e;
}

.check-body {
  flex: 1;
  min-width: 0;
}

.check-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.check-label {
  font-size: 27rpx;
  font-weight: 500;
  margin-right: 12rpx;
}

.check-desc {
  font-size: 23rpx;
  color: #8c959f;
}

.check-detail {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #4d5560;
  word-break: break-all;
  line-height: 1.5;
}

.muted {
  color: #afb8c1;
}

/* ── 按钮 / 结果 ────────────────────────────────────── */
.btn {
  margin-top: 28rpx;
}

.result {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  font-size: 25rpx;
}

.result-ok {
  background: #dafbe1;
  color: #1a7f37;
}

.result-fail {
  background: #ffebe9;
  color: #cf222e;
}

/* ── 说明 ───────────────────────────────────────────── */
.note {
  font-size: 24rpx;
  color: #6e7781;
  line-height: 1.6;
  margin-bottom: 8rpx;
}
